{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/agents/schemas/proposal.schema.json",
  "title": "Write-stage proposal",
  "description": "runs/<week>/proposals/<kind>.json (contract C3). Every generated text carries non-empty source_ids.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "week", "highlights"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "project_highlights" },
        "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["project", "date", "text", "source_ids"],
            "additionalProperties": false,
            "properties": {
              "project": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "text": { "type": "string", "minLength": 1 },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "week", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "now_page" },
        "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "remove_ids": {
          "type": "array",
          "description": "Ids of now-page cards to retire because the week's notes say the area is over.",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "description", "source_ids"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "week", "post"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "blog_post" },
        "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "post": {
          "type": "object",
          "required": [
            "slug",
            "title",
            "summary",
            "tags",
            "date",
            "body_markdown",
            "source_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "title": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "tags": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "body_markdown": { "type": "string", "minLength": 1 },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
