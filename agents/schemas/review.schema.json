{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/agents/schemas/review.schema.json",
  "title": "Review-stage verdict",
  "description": "runs/<week>/review.json (contract C3).",
  "type": "object",
  "required": ["week", "verdict", "violations"],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "rule", "detail"],
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1,
            "description": "Path of the offending artifact, e.g. proposals/blog_post.json, relative to runs/<week>/."
          },
          "rule": {
            "type": "string",
            "enum": [
              "unresolvable_citation",
              "unsourced_number",
              "private_leak",
              "style_violation",
              "duplicate",
              "schema_invalid"
            ]
          },
          "detail": { "type": "string", "minLength": 1 },
          "source_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
